<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TabletMonitor</AssemblyName>
    <RootNamespace>TabletMonitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.2.2</Version>
    <Product>TabletMonitor</Product>
    <Description>Tablet lub telefon jako dodatkowy monitor</Description>

    <!-- One self-contained exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- DPI awareness must stay in app.manifest for WPF; WinForms is only used for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is used only for the tray icon; keep WPF types unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <!-- Bundled payload: virtual display driver, adb (USB) and the Android app -->
  <ItemGroup>
    <EmbeddedResource Include="..\third_party\VirtualDisplayDriver\x64\*" LogicalName="driver/%(Filename)%(Extension)" />
    <!-- adb is fetched by build.ps1; without it the app simply has no USB mode -->
    <EmbeddedResource Include="..\third_party\adb\adb.exe;..\third_party\adb\AdbWinApi.dll;..\third_party\adb\AdbWinUsbApi.dll" LogicalName="adb/%(Filename)%(Extension)" Condition="Exists('..\third_party\adb\adb.exe')" />
    <EmbeddedResource Include="..\build\TabletMonitor.apk" LogicalName="android/TabletMonitor.apk" Condition="Exists('..\build\TabletMonitor.apk')" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
